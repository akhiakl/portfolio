# Contentful space + environment
CONTENTFUL_SPACE_ID=
CONTENTFUL_ENVIRONMENT=master
NEXT_PUBLIC_CONTENTFUL_LOCALE=en-US

# Content Delivery API token (published content)
CONTENTFUL_ACCESS_TOKEN=
# Content Preview API token (drafts, used only in Draft Mode)
CONTENTFUL_PREVIEW_ACCESS_TOKEN=

# Shared secret in the Contentful preview URL: /api/draft/enable?secret=<value>&path=/
CONTENTFUL_PREVIEW_SECRET=
# Shared secret sent by the Contentful webhook as the x-revalidate-secret header
CONTENTFUL_REVALIDATE_SECRET=

# Only for `pnpm cms:setup` (never needed at runtime)
CONTENTFUL_MANAGEMENT_TOKEN=
